{
  "targets": {
    "release": {
      "outFile": "src/wasm/tensor.wasm",
      "bindings": "esm",
      "optimizeLevel": 3,
      "shrinkLevel": 1,
      "converge": true,
      "enable": ["simd"],
      "noAssert": true,
      "uncheckedBehavior": "always",
      "exportRuntime": true
    }
  }
}
